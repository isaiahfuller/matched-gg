{
  "name": "@g4mr/backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "seed": "ts-node -r tsconfig-paths/register ./src/infrastructure/igdb/db/seed/seed.ts",
    "seed:max": "node --loader ts-node/esm -r ts-node/register -r tsconfig-paths/register --max-old-space-size=8192 ./src/infrastructure/igdb/db/seed/seed.ts",
    "webhooks": "ts-node -r tsconfig-paths/register ./src/infrastructure/igdb/db/webhooks/webhooks.ts",
    "webhooks:server": "ts-node -r tsconfig-paths/register ./src/infrastructure/igdb/db/webhooks/server.ts",
    "generate": "yarn drizzle-kit generate",
    "migrate": "ts-node -r tsconfig-paths/register ./src/db/migrate.ts",
    "dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.3",
    "@types/passport-steam": "^1.0.5",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.26.2",
    "drizzle-orm": "^0.35.1",
    "express": "^5.1.0",
    "express-session": "^1.18.0",
    "igdb-api-node": "^5.0.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-steam-openid": "^1.1.5",
    "pg": "^8.13.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/igdb-api-node": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "drizzle-kit": "^0.26.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tsdoc": "^0.5.3",
    "jest": "^30.5.2",
    "prettier": "^3.9.8",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "zod": "^4.6.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "modulePaths": [
      "<rootDir>/../"
    ],
    "moduleNameMapper": {
      "^@config/(.*)$": "<rootDir>/../src/config/__mocks__/$1",
      "^@util/(.*)$": "<rootDir>/../src/util/__mocks__/$1"
    }
  }
}
