{
  "name": "g4mr",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "backend:generate": "yarn --cwd backend drizzle-kit generate",
    "backend:migrate": "yarn --cwd backend migrate",
    "backend:seed": "yarn --cwd backend seed",
    "build": "yarn workspaces foreach -Api run build",
    "dev": "yarn workspaces foreach -Api run dev",
    "lint": "yarn workspaces foreach -Api run lint",
    "start:backend": "yarn --cwd backend migrate && yarn --cwd backend start:prod",
    "start:frontend": "yarn --cwd frontend start:prod",
    "start:prod": "yarn --cwd backend migrate && yarn start:backend & yarn start:frontend",
    "test": "yarn workspaces foreach -Api run test",
    "webhooks": "yarn --cwd backend webhooks:server & yarn --cwd backend webhooks",
    "webhooks:add": "yarn --cwd backend webhooks"
  },
  "packageManager": "yarn@4.1.1",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/passport-local": "^1.0.38",
    "concurrently": "^10.0.5"
  }
}
