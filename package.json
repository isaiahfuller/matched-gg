{
  "name": "g4mr",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "backend:generate": "yarn --cwd backend drizzle-kit generate",
    "backend:migrate": "yarn --cwd backend migrate",
    "backend:seed": "yarn --cwd backend seed",
    "build": "yarn --cwd frontend build",
    "dev": "yarn workspaces foreach -Api run dev",
    "lint": "yarn workspaces foreach -Api run lint",
    "start:backend": "yarn --cwd backend start",
    "start:frontend": "yarn --cwd frontend start",
    "test": "yarn workspaces foreach -Api run test",
    "webhooks": "yarn --cwd backend webhooks:server",
    "webhooks:add": "yarn --cwd backend webhooks"
  },
  "packageManager": "yarn@4.1.1"
}
