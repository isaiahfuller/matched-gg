{
  "name": "g4mr",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "landing",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn --cwd backend dev\" \"yarn --cwd frontend dev\"",
    "lint": "concurrently \"yarn --cwd backend lint\" \"yarn --cwd frontend lint\" \"yarn --cwd landing lint\"",
    "test": "concurrently \"yarn --cwd backend test\"",
    "start": "yarn --cwd backend start",
    "build": "yarn --cwd frontend build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
